    {
      "id": "5b35fa94-5da5-4d9f-aa0a-ee01447b748f",
      "type": "markdown",
      "source": "Install python from https://www.python.org/"
    },
    {
      "id": "2242c43b-5a4b-4cb2-bf69-3d81d0f0b9c4",
