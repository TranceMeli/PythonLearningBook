      }
    },
    {
      "id": "275ca1ed-b3ff-4c48-8c1b-49fa9dc70d69",
      "type": "markdown",
      "source": "Indentation in Python is very important.\u003Cbr\u003E\nThe two code example will show you."
    },
    {
      "id": "3041d6bf-8072-4aa3-b6b8-c20b59f9892f",
      "type": "code",
      "language": "python",
      "source": "if 10 \u003E 2:\n    print(\u0022Ten is greater than two\u0022)",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "Ten is greater than two\n",
          "channel": "stdout"
        }
      ],
      "metadata": {
        "execution_count": 5
      }
    },
    {
      "id": "d2c1b8a5-97d2-41d8-bf07-fd89cde320c9",
      "type": "code",
      "language": "python",
      "source": "if 10 \u003E 2:\nprint(\u0022Ten is greater than two\u0022)",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "IndentationError: expected an indented block after \u0027if\u0027 statement on line 1 (111631573.py, line 2)\r\n  \u001B[36mCell\u001B[39m\u001B[36m \u001B[39m\u001B[32mIn[6]\u001B[39m\u001B[32m, line 2\u001B[39m\n\u001B[31m    \u001B[39m\u001B[31mprint(\u0022Ten is greater than two\u0022)\u001B[39m\n    ^\n\u001B[31mIndentationError\u001B[39m\u001B[31m:\u001B[39m expected an indented block after \u0027if\u0027 statement on line 1\n",
          "isError": true,
          "errorName": "IndentationError",
          "errorStackTrace": "  \u001B[36mCell\u001B[39m\u001B[36m \u001B[39m\u001B[32mIn[6]\u001B[39m\u001B[32m, line 2\u001B[39m\n\u001B[31m    \u001B[39m\u001B[31mprint(\u0022Ten is greater than two\u0022)\u001B[39m\n    ^\n\u001B[31mIndentationError\u001B[39m\u001B[31m:\u001B[39m expected an indented block after \u0027if\u0027 statement on line 1\n"
